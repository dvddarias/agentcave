{
  "name": "@agentcave/client",
  "version": "0.2.1",
  "description": "Tiny typed client for the AgentCave HTTP API (zero dependencies).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvddarias/agentcave.git",
    "directory": "client"
  },
  "homepage": "https://github.com/dvddarias/agentcave/tree/main/client#readme",
  "keywords": [
    "agentcave",
    "ai",
    "agents",
    "openrouter",
    "client"
  ],
  "exports": {
    ".": {
      "agentcave-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
