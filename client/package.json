{
  "name": "@agentcave/client",
  "version": "0.1.0",
  "description": "Tiny typed client for the AgentCave HTTP API (zero dependencies).",
  "type": "module",
  "exports": {
    ".": {
      "agentcave-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
